<?xml version="1.0" encoding="UTF-8"?>
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" version="2007" revision="B">
  <!-- Synthetic golden acceptance model: dense unconfigured URCB inventory + indexed URCB/BRCB + SGCB coexistence. -->
  <Header id="AR_IEDSCOUT_GOLDEN_SYNTHETIC" version="1" revision="A" />
  <IED name="IEDGOLDEN" manufacturer="AR" type="ProtectionIED" configVersion="1">
    <AccessPoint name="P1">
      <Server>
        <LDevice inst="LD0">
          <LN0 lnClass="LLN0" lnType="LLN0Type">
            <DataSet name="dsGO">
              <FCDA ldInst="LD0" lnClass="XCBR" lnInst="1" doName="Pos" daName="stVal" fc="ST" />
              <FCDA ldInst="LD0" lnClass="XCBR" lnInst="1" doName="Pos" daName="q" fc="ST" />
              <FCDA ldInst="LD0" lnClass="XCBR" lnInst="1" doName="Pos" daName="t" fc="ST" />
            </DataSet>
            <SettingControl numOfSGs="4" actSG="1" />
            <ReportControl name="Uncfg01" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg02" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg03" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg04" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg05" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg06" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg07" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg08" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg09" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg10" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg11" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg12" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg13" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg14" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg15" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg16" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg17" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg18" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg19" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg20" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg21" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg22" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg23" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg24" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg25" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg26" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg27" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg28" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg29" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Uncfg30" confRev="1" buffered="false" indexed="false" />
            <ReportControl name="Unbuffer" datSet="dsGO" rptID="IEDGOLDENLD0/LLN0$RP$Unbuffer" confRev="31" buffered="false" indexed="true" bufTime="100" intgPd="1000">
              <RptEnabled max="2" />
            </ReportControl>
            <ReportControl name="Buffer" datSet="dsGO" rptID="IEDGOLDENLD0/LLN0$BR$Buffer" confRev="32" buffered="true" indexed="true" bufTime="75" intgPd="1000">
              <RptEnabled max="2" />
            </ReportControl>
          </LN0>
          <LN lnClass="XCBR" inst="1" lnType="XCBRType" />
        </LDevice>
      </Server>
    </AccessPoint>
  </IED>
  <DataTypeTemplates>
    <LNodeType id="LLN0Type" lnClass="LLN0" />
    <LNodeType id="XCBRType" lnClass="XCBR">
      <DO name="Pos" type="PosType" />
    </LNodeType>
    <DOType id="PosType" cdc="DPC">
      <DA name="stVal" bType="BOOLEAN" fc="ST" />
      <DA name="q" bType="Quality" fc="ST" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
  </DataTypeTemplates>
</SCL>
