# Transitional setting: shared codecs still retain exception-based host APIs.
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# First physical proof uses the ESP32-P4 internal EMAC/RMII path.
CONFIG_ETH_USE_ESP32_EMAC=y

# PC-to-device injector control uses the ESP32-P4 built-in USB Serial/JTAG
# controller as the primary stdio transport. One JSON command is sent per line.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
